# Dane rynkowe (real-time-ish quotes, news sentiment) - rynek US
FINNHUB_API_KEY=

# Dane fundamentalne (sprawozdania, wskazniki, DCF) - rynek US
FMP_API_KEY=

# Rynki PL/EU (GPW, XETRA, Euronext) - UWAGA: darmowy plan nie obejmuje
# fundamentow (tylko EOD), limit ~20 zapytan/dzien
EODHD_API_KEY=

# Baza danych / realtime do appki
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Warstwa 3 (klasyfikacja przyczyny spadku) - wybor dostawcy: deepseek | anthropic | gemini
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Jak czesto odpalac screener (cron expression), domyslnie co godzine w trakcie sesji NYSE
SCREENER_CRON=0 * 14-21 * * 1-5

# Watchlisty per rynek (MVP: recznie zdefiniowane). US = bare tickery,
# PL/EU = ticker.EXCHANGE w formacie EODHD.
WATCHLIST_US=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA
WATCHLIST_PL=PKN.WAR,PKO.WAR,KGH.WAR
WATCHLIST_EU=SAP.XETRA,TTE.PA,ASML.AS
