# Dane rynkowe (real-time-ish quotes, news sentiment)
FINNHUB_API_KEY=

# Dane fundamentalne (sprawozdania, wskazniki, DCF)
FMP_API_KEY=

# Baza danych / realtime do appki
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Warstwa 3 (klasyfikacja przyczyny spadku) - wybor dostawcy: deepseek | anthropic | gemini
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Jak czesto odpalac screener (cron expression), domyslnie co godzine w trakcie sesji NYSE
SCREENER_CRON=0 * 14-21 * * 1-5

# Lista tickerow do monitorowania (MVP: recznie zdefiniowana watchlist,
# docelowo mozna zastapic pelnym indeksem np. S&P 500 / WIG20)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA
